# Existing non-Docker development settings (Docker constructs its own URL).
DATABASE_URL=
TEST_DATABASE_URL=
# Docker: supply externally; never commit real values. Password must be URL-safe
# Use independent secrets.token_hex(32) values for password and AUTH_SECRET.
# Application minimum is 16 characters; production should use 64 random hex characters.
# Compose fixes POSTGRES_DB=construction_db to isolate the intended database.
# Keep POSTGRES_USER URL-safe (letters, digits, underscores).
POSTGRES_USER=construction
POSTGRES_PASSWORD=
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Local HTTP only; set true for every HTTPS deployment.
COOKIE_SECURE=false
# Local default publishes on all interfaces; use 127.0.0.1 for a host TLS proxy.
FRONTEND_BIND_IP=0.0.0.0
# Replace with the exact frontend container IP for trusted proxy headers.
# Never use * or an untrusted/shared network; see DOCKER.md.
FORWARDED_ALLOW_IPS=127.0.0.1
